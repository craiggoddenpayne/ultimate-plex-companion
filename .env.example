# Application
APP_PORT=8080
TZ=UTC

# Optional: configure Plex without using the browser settings screen.
# Never commit a real token.
PLEX_URL=http://host.docker.internal:32400
PLEX_TOKEN=

# Media path mapping used by Codec Studio.
# MEDIA_HOST_PATH is a path on the Docker host.
# PLEX_MEDIA_ROOT is the path Plex reports in its metadata.
# MEDIA_CONTAINER_PATH is where the same files are mounted in Companion.
MEDIA_HOST_PATH=./media
PLEX_MEDIA_ROOT=/media
MEDIA_CONTAINER_PATH=/media

# Encoding defaults
HEVC_CRF=20
HEVC_PRESET=medium
