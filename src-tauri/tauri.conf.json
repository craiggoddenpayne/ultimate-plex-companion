{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ultimate Plex Companion",
  "version": "0.1.0",
  "identifier": "app.ultimateplex.companion",
  "build": {
    "frontendDist": "../native-shell"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": [],
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Entertainment",
    "shortDescription": "Your Plex universe, wherever you are.",
    "longDescription": "A lightweight native client for a self-hosted Ultimate Plex Companion server.",
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
